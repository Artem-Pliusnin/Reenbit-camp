@using Telerik.SvgIcons

<div class="label-row d-flex align-items-center gap-2">
    <TelerikButton Icon=@SvgIcon.X
                   Class="label-btn"
                   OnClick=@DeletLabel />

    <div class="d-flex align-items-center label-preview"
         style="background: @CardLabel.Label.Color">
        <span class="label-text">
            @CardLabel.Label.Text
        </span>
    </div>
    
    <TelerikButton Icon=@SvgIcon.Pencil
                   Class="label-btn"
                   OnClick=@EditLabel />
</div>


<style>
    .label-btn{
        width: 2rem;
        height: 2rem;
        border-radius: 10%;
        background-color: rgb(250, 250, 250);
        border: none;
    }

    .label-btn:hover{
        background-color: rgb(240, 240, 240);
    }
</style>