<div class="comment-item d-flex gap-2 p-2">
    <TelerikAvatar
        Type=@AvatarType.Text
        ThemeColor=@ThemeConstants.Avatar.ThemeColor.Inverse>
        @Comment.User.UserName[0]
    </TelerikAvatar>

    <div class="flex-grow-1">
        <div class="comment-header">
            <span class="comment-author">@Comment.User.UserName</span>
            <span class="comment-date">
                @Comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
            </span>
            @if (Comment.IsEdited)
            {
                <span class="edited-tag">(edited)</span>
            }
        </div>

        @if (!IsEditing)
        {
            <div class="comment-text p-2">
                @Comment.Text
            </div>
        }
        else
        {
            <div class="comment-edit">
                <textarea class="form-control mb-2"
                      rows="3"
                      maxlength="1000"
                      @bind=@InputComment>
            </textarea>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm"
                            @onclick=@SaveComment>
                        Save
                    </button>

                    <button class="btn btn-light btn-sm"
                            @onclick=@CancelWritingComment>
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (Comment.User.Id == CurrentUser.User.Id)
        {
            <div class="comment-actions">
                <TelerikButton
                    OnClick=@EditComment
                    FillMode=@ThemeConstants.Button.FillMode.Link>
                    Edit
                </TelerikButton>
                <span>•</span>
                <TelerikButton
                    OnClick=@OpenPopover
                    FillMode=@ThemeConstants.Button.FillMode.Link
                    Id=@($"delete-{Comment.Id}")>
                    Delete
                </TelerikButton>
            </div>
        }

        <TelerikPopover
            @ref=@PopoverRef
            AnchorSelector=@($"#delete-{Comment.Id}")
            Position="@PopoverPosition.Top"
            Collision=@PopoverCollision.Fit
            Offset="10"
            Width="15rem">

            <PopoverContent>
                <div class="d-flex flex-column align-items-center py-2">
                    <strong>Delete comment?</strong>
                    
                    <hr class="w-100"/>
                    
                    <span class="w-100">Deleting a comment is forever. There is no undo.</span>

                    <hr class="w-100"/>

                    <TelerikButton
                        OnClick=@DeleteComment
                        Class="btn-danger delete-button w-100">
                        Delete comment
                    </TelerikButton>
                </div>
            </PopoverContent>

        </TelerikPopover>
    </div>
</div>

<style>
    .k-button{
        padding: 0;
    }

    .k-button-link-base:focus{
        box-shadow: none;
    }
    
    .k-button-text{
        font-size: 0.8rem;
    }
    
    .delete-button{
        height: 2rem;
    }
</style>