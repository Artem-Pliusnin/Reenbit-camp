@using WebApp.Components.Auth 
@using WebApp.Components.Invitations

<nav class="navbar">
    <div class="navbar-left">
        <TelerikButton 
            Icon=@Telerik.SvgIcons.SvgIcon.Menu
            Class="navbar-toggler"
            OnClick=@ToggleMenu/>

        <span class="brand">Trello</span>

        <div class="navbar-links @(isOpen ? "open" : "")">
            <NavLink href="/" Match=@NavLinkMatch.All>Boards</NavLink>
        </div>
        <div class="navbar-links @(isOpen ? "open" : "")">
            <NavLink href="/archive" Match=@NavLinkMatch.All>Archive</NavLink>
        </div>
    </div>

    <div class="navbar-right">
        <BoardInvitationsMenu />
        
        <div class="user-profile" @onclick=@NavigateToProfile>
            @if (isLoadinUser)
            {
                <div class="d-flex justify-content-center align-items-center"
                     style="width: 4rem">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                <span class="user-name">
                    @CurrentUser.UserName
                </span>
                
                @if (CurrentUser.Avatar is null)
                {
                    <TelerikAvatar
                        Type=@AvatarType.Text
                        Class="avatar"
                        ThemeColor=@ThemeConstants.Avatar.ThemeColor.Inverse>
                        @(!string.IsNullOrWhiteSpace(CurrentUser.UserName)
                            ? CurrentUser.UserName[0]
                            : '?')
                    </TelerikAvatar>
                }
                else
                {
                    <TelerikAvatar Class="avatar" Type=@AvatarType.Image>
                        <img src=@CurrentUser.Avatar.FileUrl/>
                    </TelerikAvatar>
                }
            }
        </div>

        <Logout />
    </div>
</nav>

<style>
    .navbar-links a {
        color: #176B87;
        text-decoration: none;
        font-size: 1.2rem;
        padding: 0.4rem 0.6rem;
        border-radius: 4px;
    }
    
    .navbar-links a:hover {
        background-color: #B4D4FF;
        color: #176B87;
    }

    .navbar-links a.active{
        color: #176B87;
        background-color: #B4D4FF;
        border-bottom: 2px solid #176B87;
    }
    
    .avatar{
        width: 3rem;
        height: 3rem;
        flex-basis: 3rem;
    }

    .avatar .k-avatar-text{
        font-size: 1.2rem;
        font-weight: bold;
    }

    .navbar-toggler {
        height: 2.5rem;
        width: 3rem;
        border: none;
        background-color: #B4D4FF;
        color: #176B87;
        font-size: 1.3rem;
        cursor: pointer;
        display: none;
    }

    .navbar-toggler:hover {
        background-color: #86B6F6;
    }

    .navbar-toggler:focus {
        outline: none;
        box-shadow: none;
    }
    
    @@media (max-width: 768px) {
        .navbar-toggler {
            display: flex;
            align-items: center;
        }
    }
</style>