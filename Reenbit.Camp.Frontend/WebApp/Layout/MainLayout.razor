@inherits LayoutComponentBase
@using WebApp.Components.Shared
@using WebApp.Components.Auth


<div class="page">
    <AuthorizeView>
        <Authorized>
            <SocketHubContext>
                <TelerikRootComponent>
                    <header class="top-navbar">
                        <NavMenu UserId=@GetUserId(context.User)/>
                    </header>

                    <main>
                        @Body
                    </main>
                </TelerikRootComponent>
            </SocketHubContext>
        </Authorized>

        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
</div>