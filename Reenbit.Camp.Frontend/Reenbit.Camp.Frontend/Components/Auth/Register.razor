<h3 class="text-center mb-4">Sign Up</h3>

<EditForm Model="model" OnValidSubmit="OnRegisterAsync" class="d-flex flex-column gap-2 align-items-center">
    <DataAnnotationsValidator />

    <div class="form-group mb-2 w-100">
        <label for="InputFirstName">First name</label>
        <InputText
            @bind-Value="model.FirstName"
            class="form-control"
            id="InputFirstName"
            placeholder="Username" />
        <ValidationMessage For="@(() => model.FirstName)" />
    </div>

    <div class="form-group mb-2 w-100">
        <label for="InputLastName">Last name</label>
        <InputText
            @bind-Value="model.LastName"
            class="form-control"
            id="InputLastName"
            placeholder="Last name (optional)" />
        <ValidationMessage For="@(() => model.LastName)" />
    </div>

    <div class="form-group mb-2 w-100">
        <label for="InputEmail">Email</label>
        <InputText
            @bind-Value="model.Email"
            class="form-control"
            id="InputEmail"
            placeholder="Email" />
        <ValidationMessage For="@(() => model.Email)" />
    </div>
    
    <div class="form-group mb-2 w-100">
        <label for="InputPassword">Password</label>
        <InputText
            @bind-Value="model.Password"
            class="form-control"
            type="password"
            id="InputPassword"
            placeholder="Password" />
        <ValidationMessage For="@(() => model.Password)" />
    </div>
    
    <div class="form-group mb-2 w-100">
        <label for="InputRepeatPassword">Repeat Password</label>
        <InputText
            @bind-Value="model.RepeatPassword"
            class="form-control"
            type="password"
            id="InputRepeatPassword"
            placeholder="Repeat password" />
        <ValidationMessage For="@(() => model.RepeatPassword)" />
    </div>
    
    <button type="submit" class="btn submit-btn mt-3">Sign Up</button>
</EditForm>