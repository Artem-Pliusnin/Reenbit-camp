@page "/board/{boardId:int}"
@using WebApp.Components.Boards

@if(isLoading)
{
    <div class="d-flex justify-content-center align-items-center w-100" 
         style="height: 80vh">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="board-layout">
        <div class="board-header">
            @if (!IsEditingTitle)
            {
                <h4 class="board-title"
                    @onclick=@StartEditTitle>
                    @Board.Title
                </h4>
            }
            else
            {
                <input class="form-control form-control-sm board-title-input" 
                       @bind=@TitleInput 
                       @bind:event="oninput" 
                       @onblur=@SaveTitle 
                       @onkeydown=@OnTitleKeyDown
                       maxlength=50
                       autofocus />
            }
            <TelerikButton Icon=@Telerik.SvgIcons.SvgIcon.User
                           FillMode="ButtonFillMode.Flat"
                           OnClick="@OpenMembersDialog">
                Members
            </TelerikButton>
        </div>

        <div class="board-content">
            <CascadingValue Value=@Board>
                <BoardLists></BoardLists>
            </CascadingValue>
        </div>
    </div> 
}

<TelerikDialog @bind-Visible="@IsMembersDialogOpen"
               Width="80rem"
               ShowCloseButton="true">

    <DialogTitle>
        Board members
    </DialogTitle>

    <DialogContent>
        <div class="container-fluid">
            <div class="row g-3">

                <!-- MEMBERS LIST -->
                <div class="col-12 col-md-7">
                    <BoardMembersList BoardId="@Board.Id" />
                </div>

                <!-- INVITE FORM -->
                <div class="col-12 col-md-5">
                    <BoardInviteForm BoardId="@Board.Id" />
                </div>

            </div>
        </div>
    </DialogContent>
</TelerikDialog>

