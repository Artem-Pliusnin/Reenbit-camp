@using Telerik.SvgIcons

<div class="mb-3">
    <div class="d-flex flex-row gap-2 mb-3">
        <h5 class="fw-semibold mb-2">Attachments</h5>

        <TelerikButton
            Class="add-file-button"
            OnClick=@OpenAddMenu>
            + Add
        </TelerikButton>
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var attachment in Attachments)
        {
        <div class="attachment-row">
            @if (IsImage(attachment))
            {
            <a href=@attachment.FileUrl
               target="_blank"
               class="attachment-image">
                <img src=@attachment.FileUrl />
            </a>
            }
            else
            {
            <a href=@attachment.FileUrl
               target="_blank"
               class="attachment-file">
                <TelerikSvgIcon Icon=@SvgIcon.FilePdf Size="lg" />
                <span>@attachment.FileName</span>
            </a>
            }

            <TelerikButton
                Icon=@SvgIcon.Trash
                Class="attachment-delete-btn"
                Size="small"
                OnClick=@(() => DeleteAttachment(attachment)) />
        </div>
        }
    </div>
</div>

<TelerikPopover @ref=@PopoverRef
                AnchorSelector=".add-file-button"
                Position=@PopoverPosition.Right
                ShowCallout="false"
                Collision=@PopoverCollision.Fit
                Width="fit-content">

    <PopoverContent>
        <div class="attachment-popup">

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div style="width:2rem"></div>

                <h6 class="mb-0">Add attachment</h6>

                <TelerikButton
                    Icon=@SvgIcon.X
                    Size="small"
                    Class="popover-btn"
                    OnClick=@CloseAddMenu/>
            </div>

            <InputFile OnChange=@OnFileSelected />

            @if (SelectedFile != null)
            {
                <div class="mt-3">
                    <div class="selected-file mb-3">
                        <small class="text-muted file-name" title="@SelectedFile.Name">
                            @SelectedFile.Name
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <TelerikButton
                            Class="btn-primary btn-sm flex-fill"
                            OnClick=@Upload>
                            Add
                        </TelerikButton>

                        <TelerikButton
                            Class="btn-light btn-sm flex-fill"
                            OnClick=@CloseAddMenu>
                            Cancel
                        </TelerikButton>
                    </div>
                </div>
            }
        </div>
    </PopoverContent>
</TelerikPopover>

<style>
    .k-button-solid-base:focus{
        box-shadow: none;
    }

    .popover-btn{
        width: 2rem;
        height: 2rem;
        border-radius: 10%;
        background-color: transparent;
        border: none;
    }
    
    .popover-btn:hover{
        background-color: rgb(240, 240, 240);
    }

    .add-file-button{
        width: 4rem;
        height: 2rem;
        border-radius: 10%;
        background-color: rgb(240, 240, 240);
        border: none;
        padding: 0;
    }

    .add-file-button:hover{
        background-color: rgb(230, 230, 230);
    }

    .btn-primary {
        background-color: #0d6efd;
        color: white;
        border: none;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
    }

    .attachment-file svg {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        color: #6c757d;
    }

    .selected-file {
        max-width: 100%;
    }

    .file-name {
        display: block;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .attachment-delete-btn {
        width: 2rem;
        height: 2rem;
        border-radius: 6px;
        background-color: transparent;
        border: none;
        color: #dc3545;
    }

    .attachment-delete-btn:hover {
        background-color: rgba(220, 53, 69, 0.1);
    }
</style>