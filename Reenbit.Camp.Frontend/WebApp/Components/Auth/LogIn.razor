@using Telerik.SvgIcons
<h3 class="text-center mb-4">Sign In</h3>

<EditForm
    Model=@model
    OnValidSubmit=@OnLogin
    class="d-flex flex-column gap-2 align-items-center">
    
    <DataAnnotationsValidator/>

    <div class="form-group mb-2 w-100">
        <label for="InputEmail">Email</label>
        
        <InputText
            @bind-Value=@model.Email
            class="form-control"
            id="InputEmail"
            placeholder="Email"/>
        
        <ValidationMessage For=@(() => model.Email)/>
    </div>

    <div class="form-group mb-2 w-100">
        <label for="InputPassword">Password</label>
        
        <InputText
            @bind-Value=@model.Password
            type="password"
            class="form-control"
            id="InputPassword"
            placeholder="Password"/>
        
        <ValidationMessage For=@(() => model.Password)/>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="text-danger w-100 text-start">@ErrorMessage</span>
    }

    <button type="submit" class="btn submit-btn mt-3">Sign In</button>
</EditForm>

<div class="w-100 d-flex flex-column align-items-center">
    <hr>
    <TelerikButton
        Icon=@SvgIcon.Google
        OnClick=@OnGoogleLogin
        Class="google-login-btn">
        Login with Google
    </TelerikButton>
</div>

<style>
    .google-login-btn{
        width: fit-content;
        height: fit-content;
        background-color: rgb(238, 245, 255);
        color: #176B87;
        border: 1px solid #176B87;
        font-weight: 500;
        padding: 0.7rem 2rem;
        box-sizing: border-box;
        border-radius: 0.5rem;
    }

    .google-login-btn:hover{
        background-color: #176B87;
        color: rgb(238, 245, 255);
    }
</style>

