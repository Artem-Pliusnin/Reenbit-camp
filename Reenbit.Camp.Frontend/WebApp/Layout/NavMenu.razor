@using WebApp.Components.Auth 
@using WebApp.Components.Invitations

<nav class="navbar">
    <div class="navbar-left">
        <TelerikButton 
            Icon=@Telerik.SvgIcons.SvgIcon.Menu
            Class="navbar-toggler"
            OnClick=@ToggleMenu/>

        <span class="brand">Trello</span>

        <div class="navbar-links @(isOpen ? "open" : "")">
            <NavLink href="/" Match=@NavLinkMatch.All>Boards</NavLink>
        </div>
    </div>

    <div class="navbar-right">
        <AuthorizeView>
            <Authorized>
                <BoardInvitationsMenu />
                
                <div class="d-flex flex-row gap-1 align-items-center">
                    <span class="user-name">
                        @context.User.Identity?.Name
                    </span>

                    <TelerikAvatar
                        Type=@AvatarType.Text
                        ThemeColor=@ThemeConstants.Avatar.ThemeColor.Inverse>
                        @(!string.IsNullOrWhiteSpace(context.User.Identity?.Name)
                            ? context.User.Identity.Name[0]
                            : '?')
                    </TelerikAvatar>
                </div>

                <Logout />
            </Authorized>

            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<style>
    .navbar-links a {
        color: #176B87;
        text-decoration: none;
        font-size: 1.2rem;
        padding: 0.4rem 0.6rem;
        border-radius: 4px;
    }
    
    .navbar-links a:hover {
        background-color: #B4D4FF;
        color: #176B87;
    }

    .navbar-links a.active{
        color: #176B87;
        background-color: #B4D4FF;
        border-bottom: 2px solid #176B87;
    }
    
    .k-avatar-md{
        width: 3rem;
        height: 3rem;
        flex-basis: 3rem;
    }

    .k-avatar-text{
        font-size: 1.2rem;
        font-weight: bold;
    }

    .navbar-toggler {
        height: 2.5rem;
        width: 3rem;
        border: none;
        background-color: #B4D4FF;
        color: #176B87;
        font-size: 1.3rem;
        cursor: pointer;
        display: none;
    }

    .navbar-toggler:hover {
        background-color: #86B6F6;
    }

    .navbar-toggler:focus {
        outline: none;
        box-shadow: none;
    }
    
    @@media (max-width: 768px) {
        .navbar-toggler {
            display: flex;
            align-items: center;
        }
    }
</style>