<div class="position-relative">
    <TelerikButton Icon=@Telerik.SvgIcons.SvgIcon.Bell
                   Class="dialog-icon-button"
                   OnClick="@Toggle" />

    <TelerikPopover @ref="@PopoverRef"
                    AnchorSelector=".dialog-icon-button"
                    Width="20rem"
                    Position=@PopoverPosition.Bottom>

        <PopoverContent>
            <strong>Board invitations</strong>
            
            @if (IsLoading)
            {
                <div class="text-center p-3">
                    <TelerikLoader Size="LoaderSize.Small"/>
                </div>
            }
            else if (!Invitations.Any())
            {
                <div class="text-muted p-3">
                    No invitations yet
                </div>
            }
            else
            {
                <TelerikListView Data="@Invitations">
                    <Template>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="fw-semibold">@context.Board.Title</div>
                                <small class="text-muted">
                                    Invited by @context.InvitedByUser.UserName
                                </small>
                            </div>

                            <div class="d-flex gap-1">
                                <TelerikButton Icon="@Telerik.SvgIcons.SvgIcon.Check"
                                               Size="ButtonSize.Small"
                                               OnClick="@(() => Accept(context.Id))"/>

                                <TelerikButton Icon="@Telerik.SvgIcons.SvgIcon.X"
                                               Size="ButtonSize.Small"
                                               FillMode="ButtonFillMode.Flat"
                                               OnClick="@(() => Decline(context.Id))"/>
                            </div>
                        </div>
                    </Template>
                </TelerikListView>
            }
        </PopoverContent>
    </TelerikPopover>
</div>
