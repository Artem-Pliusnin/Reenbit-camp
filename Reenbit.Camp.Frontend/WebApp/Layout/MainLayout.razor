@inherits LayoutComponentBase
@using WebApp.Components.Shared
@using WebApp.Components.Auth
@using WebApp.Components.FAQChat


<div class="page">
    <AuthorizeView>
        <Authorized>
            <SocketHubContext>
                <TelerikRootComponent>
                    <header class="top-navbar">
                        <NavMenu UserId=@GetUserId(context.User) @ref=@navMenuRef/>
                    </header>

                    <main>
                        <CascadingValue Name="NavMenu" Value=@navMenuRef>
                            @Body
                        </CascadingValue>
                    </main>
                </TelerikRootComponent>
            </SocketHubContext>
        </Authorized>

        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
</div>