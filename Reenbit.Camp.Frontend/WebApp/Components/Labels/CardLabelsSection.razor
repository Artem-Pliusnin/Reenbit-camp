@using Telerik.SvgIcons

<div class="mb-3">
    <h5 class="fw-semibold mb-2">Labels</h5>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (CheckCardLabelsManagingPermision())
        {
            <TelerikButton
                OnClick=@OpenAddMenu
                Class="add-button">
                + Add
            </TelerikButton>
        }

        @foreach (var cardLabel in CardLabels)
        {
            <div class="d-flex align-items-center label"
                 style="background: @cardLabel.Label.Color"
                 onclick=@OpenAddMenu>
                <span class="label-text">
                    @cardLabel.Label.Text
                </span>
            </div>
        }
    </div>
</div>

<TelerikPopover @ref=@PopoverRef
                AnchorSelector=".add-button"
                Position=@PopoverPosition.Right
                ShowCallout=@false
                Collision=@PopoverCollision.Fit
                Width="15rem">

    <PopoverContent>
        <div class="label-popup">

            @if (IsCreateMode)
            {
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <TelerikButton 
                        Icon=@SvgIcon.ArrowLeft
                        Size="small"
                        OnClick=@ChangeToBaseMode
                        Class="popover-btn">
                    </TelerikButton>

                    <h6 class="mb-0">Create label</h6>

                    <TelerikButton
                        Icon=@SvgIcon.X
                        Size="small"
                        OnClick=@ClosAddMenu
                        Class="popover-btn">
                    </TelerikButton>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Preview</small>
                    
                    <div class="d-flex align-items-center label-preview"
                         style="background: @NewLabelColor">
                        <span class="label-text">
                           @NewLabelText
                        </span>
                    </div>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Title</small>

                    <input class="form-control form-control-sm"
                           placeholder="Label title"
                           maxlength="30"
                           @bind=@NewLabelText
                           @bind:event="oninput"
                           @bind:after=@(() => PopoverRef?.Refresh())
                           />
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Color</small>

                    <TelerikColorPicker
                        @bind-Value=@NewLabelColor
                        OnChange=@ColorPickerOnChange
                        ValueFormat=@ColorFormat.Hex
                        AdaptiveMode=@AdaptiveMode.Auto
                        PopupClass="k-popup-fit"/>

                </div>
                
                <TelerikButton
                    OnClick=@CreateLabel
                    Class="btn-light btn-sm w-100">
                    Create
                </TelerikButton>
            }
            else if(IsEditMode)
            {
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <TelerikButton 
                        Icon=@SvgIcon.ArrowLeft
                        Size="small"
                        OnClick=@ChangeToBaseMode
                        Class="popover-btn">
                    </TelerikButton>

                    <h6 class="mb-0">Edit label</h6>

                    <TelerikButton
                        Icon=@SvgIcon.X
                        Size="small"
                        OnClick=@ClosAddMenu
                        Class="popover-btn">
                    </TelerikButton>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Preview</small>

                    <div class="d-flex align-items-center label-preview"
                         style="background: @EditLabel.Color">
                        <span class="label-text">
                           @EditLabel.Text
                        </span>
                    </div>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Title</small>

                    <input class="form-control form-control-sm"
                           placeholder="Label title"
                           maxlength="30"
                           @bind=@EditLabel.Text
                           @bind:event="oninput"
                           @bind:after=@(() => PopoverRef?.Refresh())
                           />
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Color</small>

                    <TelerikColorPicker
                        @bind-Value=@EditLabel.Color
                        OnChange=@ColorPickerOnChange
                        ValueFormat=@ColorFormat.Hex
                        AdaptiveMode=@AdaptiveMode.Auto
                        PopupClass="k-popup-fit"/>

                </div>
                
                <div class="d-flex gap-3">
                    <TelerikButton
                        OnClick=@SaveEditedLabel
                        Class="btn-primary flex-fill">
                        Save
                    </TelerikButton>

                    <TelerikButton
                        OnClick=@DeleteLabel
                        Class="btn-danger flex-fill">
                        Delete
                    </TelerikButton>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div style="width: 2rem"></div>

                    <h6 class="mb-0">Labels</h6>

                    <TelerikButton
                        Icon=@SvgIcon.X
                        Size="small"
                        OnClick=@ClosAddMenu
                        Class="popover-btn">
                    </TelerikButton>
                </div>
                
                <div class="d-flex flex-column align-items-center gap-2 labels-cont">
                    @foreach (var cardLabel in CardLabels)
                    {
                        <CardLabelRow CardLabel=@cardLabel
                                      OnDelete=@DeleteCardLabel
                                      ObEdit=@ChangeToEditMode/>
                    }
                </div>

                <hr/>

                <small class="text-muted">Available</small>

                <div class="d-flex flex-column align-items-center gap-2 labels-cont">
                    @foreach (var label in AvailableLabels)
                    {
                        <LabelRow Label=@label
                                  OnAdd=@AddLabel
                                  ObEdit=@ChangeToEditMode/>
                    }
                </div>

                <hr/>

                <TelerikButton
                    OnClick=@ChangeToCreateMode
                    Class="btn-light btn-sm w-100">
                    Create new label
                </TelerikButton>
            }

        </div>
    </PopoverContent>
</TelerikPopover>


<style>
    .k-button-solid-base:focus{
        box-shadow: none;
    }

    .popover-btn{
        width: 2rem;
        height: 2rem;
        border-radius: 10%;
        background-color: transparent;
        border: none;
    }
    
    .popover-btn:hover{
        background-color: rgb(240, 240, 240);
    }

    .add-button{
        width: 4rem;
        height: 2rem;
        border-radius: 10%;
        background-color: rgb(240, 240, 240);
        border: none;
        padding: 0;
    }

    .add-button:hover{
        background-color: rgb(230, 230, 230);
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .btn-primary {
        background-color: #0d6efd;
        color: white;
        border: none;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
    }

    .k-popup-fit{
        position: fixed;
        top: 20% !important;
    }
    
</style>
