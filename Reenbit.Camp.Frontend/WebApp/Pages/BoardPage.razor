@page "/board/{boardId:int}"
@using Telerik.SvgIcons
@using WebApp.Components.Boards
@using WebApp.Components.BoardMembers

@if(isLoading)
{
    <div class="d-flex justify-content-center align-items-center w-100" 
         style="height: 80vh">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="board-layout">
        <div class="board-header">
            @if (!IsEditingTitle)
            {
                <h4 class="board-title"
                    @onclick=@StartEditTitle>
                    @Board.Title
                </h4>
            }
            else
            {
                <input class="form-control form-control-sm board-title-input" 
                       @bind=@TitleInput 
                       @bind:event="oninput" 
                       @onblur=@SaveTitle 
                       @onkeydown=@OnTitleKeyDown
                       maxlength=50
                       autofocus />
            }
            <TelerikDropDownButton
                Class="dropdown-btn"
                FillMode=@ThemeConstants.DropDownButton.FillMode.Flat>
                <DropDownButtonContent>...</DropDownButtonContent>

                <DropDownButtonItems>
                    <DropDownButtonItem
                        Icon=@Telerik.SvgIcons.SvgIcon.User
                        OnClick=@OpenMembersDialog>
                        Members
                    </DropDownButtonItem>

                    <DropDownButtonItem
                        Icon=@Telerik.SvgIcons.SvgIcon.Highlight
                        OnClick=@OpenLabelsMenu>
                        Labels
                    </DropDownButtonItem>
                </DropDownButtonItems>

            </TelerikDropDownButton>
        </div>

        <div class="board-content">
            <CascadingValue Name="Board" Value=@Board>
                <CascadingValue Name="CurrentUser" Value=@CurrentBoardMember>
                    <BoardLists></BoardLists>
                </CascadingValue>
            </CascadingValue>
        </div>
    </div> 
}

<TelerikDialog @bind-Visible=@IsMembersDialogOpen ShowCloseButton=@false Width="80vw">
    <DialogTitle>
        <div class="w-100 d-flex flex-row justify-content-between">
            <h4>Board members</h4>
            <div class="d-flex flex-row gap-1">
                <TelerikButton Icon=@Telerik.SvgIcons.SvgIcon.X
                               FillMode="ButtonFillMode.Flat"
                               Class="dialog-icon-button"
                               OnClick=@CloseMembersDialog/>
            </div>
        </div>
    </DialogTitle>

    <DialogContent>
        <CascadingValue Name="CurrentUser" Value=@CurrentBoardMember>
            <div class="container-fluid py-3">
                <div class="row g-3">
                    <div class="col-12 col-md-7 left-container">
                        <BoardMembersList BoardId=@Board.Id></BoardMembersList>
                    </div>
                    
                    <div class="col-12 col-md-5">
                        <BoardInviteForm BoardId=@Board.Id></BoardInviteForm>
                    </div>
                </div>
            </div>
        </CascadingValue>
    </DialogContent>
</TelerikDialog>

<TelerikPopover @ref=@PopoverRef
                AnchorSelector=".dropdown-btn"
                Position=@PopoverPosition.Left
                ShowCallout=@false
                Collision=@PopoverCollision.Fit
                Width="15rem">

    <PopoverContent>
        <div class="label-popup">

            @if (IsCreateMode)
            {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <TelerikButton
                    Icon=@SvgIcon.ArrowLeft
                    Size="small"
                    OnClick=@ChangeToBaseMode
                    Class="popover-btn">
                </TelerikButton>

                <h6 class="mb-0">Create label</h6>

                <TelerikButton
                    Icon=@SvgIcon.X
                    Size="small"
                    OnClick=@ClosAddMenu
                    Class="popover-btn">
                </TelerikButton>
            </div>

            <div class="mb-3">
                <small class="text-muted">Preview</small>

                <div class="d-flex align-items-center label-preview"
                     style="background: @NewLabelColor">
                        <span class="label-text">
                           @NewLabelText
                        </span>
                </div>
            </div>

            <div class="mb-3">
                <small class="text-muted">Title</small>

                <input class="form-control form-control-sm"
                       placeholder="Label title"
                       maxlength="30"
                       @bind=@NewLabelText
                       @bind:event="oninput"
                       @bind:after=@(() => PopoverRef?.Refresh())
                />
            </div>

            <div class="mb-3">
                <small class="text-muted">Color</small>

                <TelerikColorPicker
                    @bind-Value=@NewLabelColor
                    OnChange=@ColorPickerOnChange
                    ValueFormat=@ColorFormat.Hex
                    AdaptiveMode=@AdaptiveMode.Auto
                    PopupClass="k-popup-fit"/>

            </div>

            <TelerikButton
                OnClick=@CreateLabel
                Class="btn-light btn-sm w-100">
                Create
            </TelerikButton>
            }
            else if(IsEditMode)
            {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <TelerikButton
                    Icon=@SvgIcon.ArrowLeft
                    Size="small"
                    OnClick=@ChangeToBaseMode
                    Class="popover-btn">
                </TelerikButton>

                <h6 class="mb-0">Edit label</h6>

                <TelerikButton
                    Icon=@SvgIcon.X
                    Size="small"
                    OnClick=@ClosAddMenu
                    Class="popover-btn">
                </TelerikButton>
            </div>

            <div class="mb-3">
                <small class="text-muted">Preview</small>

                <div class="d-flex align-items-center label-preview"
                     style="background: @EditLabel.Color">
                        <span class="label-text">
                           @EditLabel.Text
                        </span>
                </div>
            </div>

            <div class="mb-3">
                <small class="text-muted">Title</small>

                <input class="form-control form-control-sm"
                       placeholder="Label title"
                       maxlength="30"
                       @bind=@EditLabel.Text
                       @bind:event="oninput"
                       @bind:after=@(() => PopoverRef?.Refresh())
                />
            </div>

            <div class="mb-3">
                <small class="text-muted">Color</small>

                <TelerikColorPicker
                    @bind-Value=@EditLabel.Color
                    OnChange=@ColorPickerOnChange
                    ValueFormat=@ColorFormat.Hex
                    AdaptiveMode=@AdaptiveMode.Auto
                    PopupClass="k-popup-fit"/>

            </div>

            <div class="d-flex gap-3">
                <TelerikButton
                    OnClick=@SaveEditedLabel
                    Class="btn-primary flex-fill">
                    Save
                </TelerikButton>

                <TelerikButton
                    OnClick=@DeleteLabel
                    Class="btn-danger flex-fill">
                    Delete
                </TelerikButton>
            </div>
            }
            else
            {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div style="width: 2rem"></div>

                <h6 class="mb-0">Labels</h6>

                <TelerikButton
                    Icon=@SvgIcon.X
                    Size="small"
                    OnClick=@ClosAddMenu
                    Class="popover-btn">
                </TelerikButton>
            </div>

            <div class="d-flex flex-column align-items-center gap-2 labels-cont">
                @foreach (var label in Labels)
                {
                    <div class="label-row d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center label" 
                             style="background: @label.Color">
                            <span class="label-text">
                                @label.Text
                            </span>
                        </div>
    
                        <TelerikButton Icon=@SvgIcon.Pencil
                                       Class="label-btn"
                                       OnClick=@(() => ChangeToEditMode(label)) />
                    </div>
                }
            </div>

            <hr/>

            <TelerikButton
                OnClick=@ChangeToCreateMode
                Class="btn-light btn-sm w-100">
                Create new label
            </TelerikButton>
            }

        </div>
    </PopoverContent>
</TelerikPopover>

<style>
    .k-menu-button{
        width: 2.5rem;
        height: 2.5rem;
    }

    .k-menu-button .k-button-text{
        font-weight: bold;
        font-size: 1.5rem;
        text-align: center;
    }
    
    .k-menu-item{
        height: 2.5rem;
        width: 15rem;
    }

    .k-button-solid-base:focus{
        box-shadow: none;
    }

    .popover-btn{
        width: 2rem;
        height: 2rem;
        border-radius: 10%;
        background-color: transparent;
        border: none;
    }

    .popover-btn:hover{
        background-color: rgb(240, 240, 240);
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .btn-primary {
        background-color: #0d6efd;
        color: white;
        border: none;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
    }

    .k-popup-fit{
        position: fixed;
        top: 20% !important;
    }

    .label-btn{
        width: 2rem;
        height: 2rem;
        border-radius: 10%;
        background-color: rgb(250, 250, 250);
        border: none;
    }

    .label-btn:hover{
        background-color: rgb(240, 240, 240);
    }
</style>