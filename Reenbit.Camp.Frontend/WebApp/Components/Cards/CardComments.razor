@using WebApp.Components.Comments

<div class="w-100 d-flex flex-column comments-panel pt-2 pb-4 px-4 gap-2">
    @if (!IsWritingComment)
    {
        <span class="comment-field p-2 text-muted fst-italic"
             @onclick=@StartWritingComment>Add a comment…</span>
    }
    else
    {
        <div class="comment-edit">
            <textarea class="form-control mb-2"
                      rows="3"
                      maxlength="1000"
                      @bind=@InputComment>
            </textarea>

            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm"
                        @onclick=@SaveComment>
                    Save
                </button>

                <button class="btn btn-light btn-sm"
                        @onclick=@CancelWritingComment>
                    Cancel
                </button>
            </div>
        </div>
    }
    
    @foreach (var comment in Comments)
    {
        <CommentRow Comment=@comment OnDelete=@DeleteComment></CommentRow>
    }
</div>
