@page "/board-meeting/{boardId:int}"
@using Telerik.SvgIcons
@using WebApp.Components.VideoChat
@using WebApp.Components.Common
@layout EmptyLayout

@if (IsLoading)
{
    <div class="loading-background d-flex justify-content-center align-items-center">
        <TelerikLoader Size="@ThemeConstants.Loader.Size.Large"
                       ThemeColor="custom-color"
                       Type="@LoaderType.ConvergingSpinner"/>
    </div>
}
else
{
    <div class="meeting-root">
        <div class="remote-strip-wrapper">
            <div id="remoteVideos" class="remote-strip">
                @foreach (var user in ConnectedUsers)
                {
                    <div @key=@user.Key id=@($"video-container-{user.Key}") class="remote-video-container">
                        @if (!user.Value.IsVideoActive)
                        {
                            <MemberCard User=@user.Value.User></MemberCard>
                        }
                        <div class="meeting-member-info">
                            @if (!user.Value.IsAudioActive)
                            {
                                <div class="microphone-badge">
                                    <MicMuteIcon Class="bi bi-mic-mute mic-icon"></MicMuteIcon>
                                </div>
                            }
                            
                            <span>@user.Value.User.UserName</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div id="screen-container" class="screen-container">
            <video id="screen-video"
                   autoplay
                   playsinline
                   class="screen-video"
                   style="display: none">
            </video>
            <div class="meeting-member-info">
                <span>@ScreenOwnerName</span>
            </div>
        </div>

        <div class="meeting-controls">
            <TelerikButton Icon=@SvgIcon.Camera
                           ThemeColor=@(CurrentUser.IsVideoActive ? "primary" : "secondary")
                           Class="meeting-btn"
                           OnClick=@ToggleVideo/>

            <TelerikButton Icon=@SvgIcon.MicrophoneOutline
                           ThemeColor=@(CurrentUser.IsAudioActive ? "primary" : "secondary")
                           Class="meeting-btn"
                           OnClick=@ToggleAudio/>

            <TelerikButton Icon=@SvgIcon.Upload
                           ThemeColor=@(IsScreenSharing ? "primary" : "secondary")
                           Class="meeting-btn"
                           OnClick=@ToggleScreenShare/>

            <TelerikButton Icon=@SvgIcon.Gear
                           ThemeColor="secondary"
                           Class="meeting-btn setting-btn"
                           OnClick=@PopoverRef!.Show/>

            <TelerikButton Icon=@SvgIcon.Logout
                           ThemeColor="error"
                           Class="meeting-btn"
                           OnClick=@LeaveMeeting/>
        </div>

        <TelerikCard Class="local-video-cont">
            <CardBody Class="local-video-cont-body">
                <video id="localVideo"
                       muted
                       autoplay
                       playsinline
                       class="user-video">
                </video>

                @if (!CurrentUser.IsVideoActive)
                {
                    <MemberCard User=@CurrentUser.User></MemberCard>
                }
                @if (!CurrentUser.IsAudioActive)
                {
                    <div class="microphone-badge current-microphone-badge">
                        <MicMuteIcon Class="bi bi-mic-mute mic-icon"></MicMuteIcon>
                    </div>
                }
            </CardBody>
        </TelerikCard>
    </div>
}

<TelerikPopover @ref=@PopoverRef
                AnchorSelector=".setting-btn"
                AnimationDuration="100"
                AnimationType=@AnimationType.SlideUp
                ShowCallout=@false
                Width="20rem"
                Height="fit-content"
                Position=@PopoverPosition.Top
                Collision=@PopoverCollision.Fit
                Offset="1">
    <PopoverContent>
        <div class="device-settings-popup-content">
            <div class="device-settings-header">
                <h3 class="device-settings-title">
                    <TelerikSvgIcon Icon=@SvgIcon.Gear Class="setting-icon"/>
                    Device Settings
                </h3>
                <TelerikButton Icon=@SvgIcon.X
                               FillMode=@ThemeConstants.Button.FillMode.Flat
                               OnClick=@PopoverRef!.Hide
                               Size=@ThemeConstants.Button.Size.Small />
            </div>

            <div class="device-settings-body">
                <div class="setting-row">
                    <TelerikSvgIcon Icon=@SvgIcon.Camera Class="setting-icon" />

                    <TelerikDropDownList Data=@_videoDevices
                                         Value=@_selectedVideoDeviceId
                                         ValueChanged=@( (string value) => OnChangeVideoDevice(value) )
                                         TextField="Label"
                                         ValueField="DeviceId"
                                         Class="setting-dropdown"
                                         Width="100%">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" MaxHeight="20rem" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                
                <div class="setting-row">
                    <TelerikSvgIcon Icon=@SvgIcon.MicrophoneOutline Class="setting-icon" />
                    
                    <TelerikDropDownList Data=@_audioDevices
                                         Value=@_selectedAudioDeviceId
                                         ValueChanged=@( (string value) => OnChangeAudioDevice(value) )
                                         TextField="Label"
                                         ValueField="DeviceId"
                                         Class="setting-dropdown"
                                         Width="100%">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" MaxHeight="20rem" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
            </div>
        </div>
    </PopoverContent>
</TelerikPopover>

<style>
    .k-loader-custom-color .k-loader-segment {
        background-color: cyan;
    }

    .user-video{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .local-video-cont{
        position: absolute;
        height: 20vh;
        aspect-ratio: 4/3;
        bottom: 1rem;
        right: 1rem;
    }
    
    .local-video-cont-body{
        padding: 0.5rem;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
    }

    .meeting-btn {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
    }

    .meeting-btn:focus{
        outline: none;
        box-shadow: none;
    }

    .mic-icon{
        width: 80%;
        height: 80%;
        fill: currentColor;
    }
    
    .setting-icon {
        width: 1rem;
        height: 1rem;
    }
    
    
    .setting-dropdown {
        flex: 1;
    }

    .k-picker-solid:focus-within{
        box-shadow: none;
        border: none;
    }

    @@media (max-width: 768px) {
        .local-video-cont{
            position: absolute;
            height: 15vh;
            aspect-ratio: 4/3;
            bottom: 4.5rem;
            right: 1rem;
        }
    }
</style>
