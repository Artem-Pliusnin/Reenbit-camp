@using Telerik.SvgIcons
<div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
    <div class="card board-card h-100 overflow-hidden">
        <button class="btn btn-sm btn-success position-absolute top-0 end-0 m-2"
                @onclick=@Restore>
            
        </button>

        <TelerikButton Icon=@SvgIcon.Upload
                       Class="btn btn-sm btn-success position-absolute top-0 end-0 m-2"
                       OnClick=@Restore>
            Restore
        </TelerikButton>
        
        <img src="Shared/common_board_background.jpeg"
             class="card-img-top board-image"
             alt="Board background"/>

        <div class="card-footer board-title">
            @Board.Title
        </div>
    </div>
</div>