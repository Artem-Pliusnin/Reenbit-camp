<div class="position-relative">
    <TelerikButton Icon=@Telerik.SvgIcons.SvgIcon.Bell
                   Class="invitations-button"
                   OnClick=@Toggle />
    
    @if (Invitations.Any())
    {
        <span class="invitations-badge">
            @Invitations.Count
        </span>
    }

    <TelerikPopover @ref=@PopoverRef
                    AnchorSelector=".invitations-button"
                    Width="20rem"
                    Position=@PopoverPosition.Bottom>

        <PopoverContent>
            <strong>Board invitations</strong>
            
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center"> 
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!Invitations.Any())
            {
                <div class="text-muted p-3">
                    No invitations yet
                </div>
            }
            else
            {
                @foreach (var invitation in Invitations)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="fw-semibold">@invitation.Board.Title</div>
                            <small class="text-muted">
                                Invited by @invitation.InvitedByUser.UserName
                            </small>
                        </div>

                        <div class="d-flex gap-1">
                            <TelerikButton Icon="@Telerik.SvgIcons.SvgIcon.Check"
                                           Size="ButtonSize.Small"
                                           OnClick=@(() => Accept(invitation.Id))/>

                            <TelerikButton Icon="@Telerik.SvgIcons.SvgIcon.X"
                                           Size="ButtonSize.Small"
                                           FillMode="ButtonFillMode.Flat"
                                           OnClick=@(() => Decline(invitation.Id))/>
                        </div>
                    </div>
                }
            }
        </PopoverContent>
    </TelerikPopover>
</div>

<style>
    .invitations-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        background-color: #176B87;
        color: #EEF5FF;
        border-radius: 50%;
        cursor: pointer;
        padding: 0;
    }

    .invitations-button:hover {
        background-color: #1B8AAF;
    }

    .invitations-button:focus {
        outline: none;
        box-shadow: none;
    }
</style>